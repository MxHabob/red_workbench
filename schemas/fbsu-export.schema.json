{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FBSU local intelligence export",
  "type": "object",
  "required": ["organization", "scope_notice", "domains", "observations", "public_metadata_resources", "collection_events"],
  "properties": {
    "organization": {
      "type": "object",
      "required": ["name", "primary_domain"],
      "properties": {
        "name": {"type": "string"},
        "primary_domain": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scope_notice": {"type": "string"},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "public_metadata_resources": {"type": "array", "items": {"type": "object"}},
    "collection_events": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "domain": {
      "type": "object",
      "required": ["id", "name", "status", "source", "source_reference", "added_at"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "status": {"enum": ["discovered", "candidate", "observed", "verified", "excluded", "requires_authorization"]},
        "source": {"type": "string"},
        "source_reference": {"type": "string"},
        "added_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["id", "category", "asset", "source", "source_reference", "first_observed_at", "last_observed_at", "collected_at", "confidence", "verification_status", "evidence_reference", "details"],
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string"},
        "asset": {"type": "string"},
        "source": {"type": "string"},
        "source_reference": {"type": "string"},
        "first_observed_at": {"type": "string", "format": "date-time"},
        "last_observed_at": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "verification_status": {"enum": ["discovered", "candidate", "observed", "verified", "excluded", "requires_authorization"]},
        "evidence_reference": {"type": "string"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
