{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "finding_id",
    "file_path",
    "description",
    "sha256",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "file_path": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}